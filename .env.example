# Copy to .env and adjust. See DESIGN.md §16.

# Secret used to sign JWTs. Required in production; a dev fallback is used otherwise.
JWT_SECRET=dev-secret-change-me

# Port the Express API listens on (also serves the built client in production).
PORT=3000

# Path to the SQLite file. ":memory:" is used by the test suite.
DATABASE_PATH=./data/jelly.sqlite

# Origin allowed by CORS in dev (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173
