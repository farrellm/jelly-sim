# Copy to .env. Every value here is a local-development default and none of them are secret.

# Matches docker-compose.yml, which publishes Postgres on 5435 to stay clear of other
# projects already using 5432–5434.
DATABASE_URL=postgres://jelly:jelly@localhost:5435/jelly

PORT=3000
NODE_ENV=development

# Comma-separated origin allowlist for CORS and the Origin check on mutating requests
# (DESIGN.md §9.3). The Vite dev server is the only client in development.
#
# Testing on a phone means the browser sends a different Origin, and every mutating
# request — including sign-in — gets a 403 until that origin is listed here too. Add it
# alongside localhost, and add the hostname to server.allowedHosts in
# apps/web/vite.config.ts so Vite will answer at all. For example:
#   CORS_ORIGINS=http://localhost:5273,https://jelly-sim.example.org
CORS_ORIGINS=http://localhost:5273

# Session cookies are Secure in production. Over plain-HTTP localhost they cannot be.
COOKIE_SECURE=false

# Used by the API test suite. Point it at a database you do not mind having truncated.
TEST_DATABASE_URL=postgres://jelly:jelly@localhost:5435/jelly_test
